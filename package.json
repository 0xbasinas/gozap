{
  "name": "electron-desktop-template-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo: desktop app, web app, API and shared packages",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter ./apps/desktop run dev",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts",
    "rename": "node apps/desktop/scripts/rename.mjs",
    "setup:cloud": "node scripts/setup-cloud.mjs",
    "cloud:doctor": "node scripts/doctor.mjs",
    "template:update": "node scripts/template-update.mjs",
    "template:status": "node scripts/template-update.mjs --check",
    "compat:date": "node scripts/compat-date.mjs --write",
    "seed:dev": "node scripts/seed-dev.mjs",
    "flags": "node scripts/flags.mjs",
    "admin:grant": "node scripts/admin.mjs grant",
    "admin:revoke": "node scripts/admin.mjs revoke",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "prepare": "husky",
    "check:bundle": "pnpm --filter ./apps/desktop run check:bundle",
    "check:release": "pnpm --filter ./apps/desktop run check:release",
    "check:fuses": "pnpm --filter ./apps/desktop run check:fuses",
    "build:unpack": "pnpm --filter ./apps/desktop run build:unpack",
    "build:win": "pnpm --filter ./apps/desktop run build:win",
    "build:mac": "pnpm --filter ./apps/desktop run build:mac",
    "build:linux": "pnpm --filter ./apps/desktop run build:linux",
    "test:e2e": "pnpm --filter ./apps/desktop run test:e2e",
    "test:update": "pnpm --filter ./apps/desktop run test:update",
    "icons": "pnpm --filter ./apps/desktop run icons",
    "release-notes": "pnpm --filter ./apps/desktop run release-notes"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
