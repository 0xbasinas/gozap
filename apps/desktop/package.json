{
  "name": "electron-desktop-template",
  "version": "0.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "0xbasinas",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:release": "node scripts/check-release-artifacts.mjs",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir -c.electronFuses.enableNodeCliInspectArguments=true",
    "check:fuses": "node scripts/check-fuses.mjs",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "release-notes": "node scripts/release-notes.mjs",
    "test:e2e": "playwright test",
    "test:update": "node scripts/prepare-update-e2e.mjs && playwright test -c playwright.update.config.ts"
  },
  "dependencies": {
    "@better-auth/electron": "^1.7.18",
    "@electron-toolkit/utils": "^4.0.0",
    "@sentry/electron": "^8.3.0",
    "better-auth": "^1.7.18",
    "conf": "^15.0.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.65.0",
    "@repo/shared": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "jsdom": "catalog:",
    "png2icons": "^2.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.35.5",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "private": true
}
