{
  "name": "@repo/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site (Astro Starlight) built from the Markdown in /docs",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "pnpm sync && astro dev",
    "build": "pnpm sync && astro build",
    "preview": "astro preview",
    "typecheck": "pnpm sync && astro check",
    "test": "node --test \"scripts/*.test.mjs\"",
    "version:create": "node scripts/version-create.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "catalog:",
    "astro": "^7.4.7",
    "mermaid": "^12.3.0",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@repo/ui": "workspace:*",
    "typescript": "catalog:"
  }
}
