---
// Light / Dark / Auto as three plain buttons instead of a native select, whose open list is drawn by the browser in
// its own blue. Uses the same storage key and data-theme as Starlight, so its theme script keeps working.
---

<starlight-theme-toggle role="group" aria-label="Theme">
  <button type="button" data-theme-value="light" aria-label="Light" title="Light"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg></button>
  <button type="button" data-theme-value="dark" aria-label="Dark" title="Dark"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg></button>
  <button type="button" data-theme-value="auto" aria-label="Auto (follow the system)" title="Auto"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" x2="16" y1="21" y2="21"></line><line x1="12" x2="12" y1="17" y2="21"></line></svg></button>
</starlight-theme-toggle>

<script>
  type Theme = 'auto' | 'dark' | 'light'
  const key = 'starlight-theme'
  const parse = (value: unknown): Theme => (value === 'dark' || value === 'light' ? value : 'auto')
  const load = (): Theme => {
    try {
      return parse(localStorage.getItem(key))
    } catch {
      return 'auto'
    }
  }
  const system = (): 'light' | 'dark' => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')

  class ThemeToggle extends HTMLElement {
    connectedCallback(): void {
      this.mark(load())
      for (const button of this.querySelectorAll('button')) {
        button.addEventListener('click', () => {
          const theme = parse(button.dataset['themeValue'])
          try {
            localStorage.setItem(key, theme === 'auto' ? '' : theme)
          } catch {
            // Private mode: the choice lasts until the page is closed.
          }
          document.documentElement.dataset['theme'] = theme === 'auto' ? system() : theme
          this.mark(theme)
        })
      }
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
        if (load() === 'auto') document.documentElement.dataset['theme'] = system()
      })
    }
    mark(theme: Theme): void {
      for (const button of this.querySelectorAll('button')) {
        button.setAttribute('aria-pressed', String(button.dataset['themeValue'] === theme))
      }
    }
  }
  customElements.define('starlight-theme-toggle', ThemeToggle)
</script>

<style>
  starlight-theme-toggle {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) - 2px);
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.3rem 0.45rem;
    border: 0;
    border-radius: calc(var(--radius) - 4px);
    background: transparent;
    color: var(--muted-foreground);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  button:hover {
    color: var(--foreground);
  }
  button[aria-pressed='true'] {
    background: var(--secondary);
    color: var(--foreground);
  }
</style>
