{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**"],
      "env": ["SENTRY_DSN"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@repo/api#build": {
      "dependsOn": ["^build", "@repo/web#build"],
      "outputs": ["dist/**"]
    }
  }
}
